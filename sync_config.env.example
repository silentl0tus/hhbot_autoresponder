# ==============================================================================
# Шаблон конфигурации синхронизации с сервером на смартфоне (POCO F6 Pro)
# Скопируйте этот файл в sync_config.env и укажите ваш реальный IP и порт ADB
# ВНИМАНИЕ: Файл sync_config.env добавлен в .gitignore и не попадет в git-репозиторий!
# ==============================================================================

# IP-адрес и порт ADB смартфона (в локальной сети Wi-Fi или через Tailscale)
PHONE_ADB_TARGET="100.x.x.x:5555"

# Путь к приложению бота внутри PRoot Ubuntu на смартфоне
PHONE_PROOT_PATH="/data/data/com.termux/files/usr/var/lib/proot-distro/containers/ubuntu/rootfs/root/bot/hh_autoresponder/hh-autoresponder"

# Имя процесса в PM2 для автоматического перезапуска после обновления сессии
PM2_PROCESS_NAME="hh-autoresponder"

