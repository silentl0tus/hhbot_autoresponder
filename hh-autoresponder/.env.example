# ============================================================
#  Конфигурация бота. Скопируй этот файл в .env и заполни свои значения.
#  Обязательны только TG_BOT_TOKEN, TG_ADMIN_CHAT_ID, HH_LOGIN, HH_PASSWORD.
# ============================================================

# ── Telegram (панель управления) ──────────────────────────
# Токен бота из @BotFather
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Твой числовой id из @userinfobot
TG_ADMIN_CHAT_ID=123456789
# Прокси для Telegram, если из страны с блокировкой (опц.): socks5://user:pass@host:port
TG_PROXY=

# ── hh.ru ─────────────────────────────────────────────────
HH_LOGIN=your_email@example.com
HH_PASSWORD=your_password
# id резюме подставится автоматически при первом входе, оставь пустым
HH_RESUME_ID=

# ── Профиль и цель ────────────────────────────────────────
DESIRED_POSITION=Python Developer
DESIRED_SALARY_MIN=100000
DESIRED_SALARY_MAX=200000
RESUME_TEXT_PATH=configs/resume.txt

# ── Поисковые запросы (через запятую) ────────────────────
SEARCH_QUERIES_RAW=Python разработчик, Backend разработчик, Python Engineer

# ── Скоринг вакансий (всё через запятую) ──────────────────
# TARGET_KEYWORDS — хотя бы одно слово в заголовке → вакансия подходит
TARGET_KEYWORDS_RAW=python, backend, django, fastapi, разработчик, программист

# NEGATIVE_KEYWORDS — слово в заголовке → вакансия отсеивается
NEGATIVE_KEYWORDS_RAW=1с, php, java, стажёр, преподаватель, менеджер, frontend, react, vue

# STACK_KEYWORDS — каждое совпадение в тексте даёт бонус к баллу
STACK_KEYWORDS_RAW=python, fastapi, docker, postgresql, linux, git, asyncio

# Вакансии с указанной ЗП ниже этого порога отсеиваются (на руки)
SALARY_FLOOR=0

# ── Гео-фильтр ─────────────────────────────────────────────
# true = отклики только по Москве/МО + полная удалёнка; false = откликаться везде
GEO_FILTER_ENABLED=true
# Подстроки для поля location (регистр не важен). Полная удалёнка всегда проходит.
ALLOWED_REGIONS_RAW=москв, московск, мо,

# ── Сопроводительное письмо ───────────────────────────────
COVER_LETTER=Здравствуйте!\n\nМеня заинтересовала ваша вакансия. У меня есть уверенный опыт в разработке бэкенда на Python (FastAPI/Django), работе с базами данных и Docker.\n\nГотов выполнить тестовое задание и пообщаться на интервью.\n\nС уважением,\nИмя Фамилия | Telegram: @ваштелеграм

# ── LLM (опционально: для прохождения анкет/тестов) ───────
AI_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=gemini-3.6-flash

# ── Темп / антибан (безопасные настройки для hh.ru) ───────
CHECK_INTERVAL_SEC=300
BROWSER_HEADLESS=true
# Пауза между откликами, сек (60–180 сек предотвращает блокировку антифродом)
APPLY_DELAY_MIN=60
APPLY_DELAY_MAX=180
# Дневной лимит (30–50 откликов в день — оптимальный объём для регулярного поиска)
MAX_APPLIES_PER_DAY_HH=35

# ── Уведомления (тихие часы, МСК) ─────────────────────────
NOTIFY_HOUR_START=9
NOTIFY_HOUR_END=22
