# ==============================================================================
# 1. Секреты, токены и переменные окружения (КРИТИЧНО - никогда не коммитить!)
# ==============================================================================
.env
.env.*
*.env
*.env.*
sync_config.env
.sync_config.env
*.secrets
secrets.*

# ==============================================================================
# 2. Браузерные сессии, cookies, токены авторизации HeadHunter и других платформ
# ==============================================================================
data/
**/data/
browser_sessions/
**/browser_sessions/
sessions/
**/sessions/
*state*.json
*state.json
*cookie*.json
*session*.json
*token*.json
*.session
*.session-journal
hh_state.json
habr_state.json
max_state.json
*captcha*.png
hh_login_captcha.png

# ==============================================================================
# 3. Персональные данные пользователя, резюме, конфиги с личной информацией
# ==============================================================================
configs/
**/configs/
!hh-autoresponder/configs/resume.example.txt
*.resume.*
*resume*.txt
*resume*.json
*resume*.pdf
*resume*.docx
*resume*.doc
*.pdf
*.docx
*.doc

# ==============================================================================
# 4. Базы данных SQLite, дампы и рантайм-хранилища
# ==============================================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# ==============================================================================
# 5. Ключи доступа, SSH, сертификаты, VPN и сетевые профили
# ==============================================================================
*.pem
*.key
*.crt
*.csr
id_rsa*
id_ed25519*
id_ecdsa*
*.pub
*.ovpn
*.wireguard
known_hosts
authorized_keys

# ==============================================================================
# 6. Межпроцессные каналы (FIFO), сокеты и локальные дампы
# ==============================================================================
*.fifo
*.sock
*.out
*.pid

# ==============================================================================
# 7. Виртуальные окружения Python
# ==============================================================================
.venv/
**/.venv/
venv/
**/venv/
env/
.env_folder/

# ==============================================================================
# 8. Кэш Python, скомпилированные байткоды и артефакты сборки
# ==============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
wheels/

# ==============================================================================
# 9. Логи, временные файлы и дампы ОС
# ==============================================================================
logs/
**/logs/
*.log
*.html
*.bak
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==============================================================================
# 10. Исключения (файлы-примеры, которые ДОЛЖНЫ быть в репозитории)
# ==============================================================================
!.env.example
!sync_config.env.example
!resume.example.txt
